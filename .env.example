PORT=3000

# Database
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=template
PG_SCHEMA=

# Auth
ADMIN_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=30d
EMAIL_TOKEN_SECRET=

# OCI Auth
OCI_AUTH_MODE=instance_principal
OCI_REGION=
OCI_CONFIG_FILE_PATH=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# OCI Queue
OCI_QUEUE_MESSAGES_ENDPOINT=
OCI_QUEUE_MAX_RETRIES=3
OCI_QUEUE_RETRY_BASE_MS=200

# OCI Object Storage
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET=
OCI_OS_MAX_RETRIES=3
OCI_OS_RETRY_BASE_MS=200

# OCI Streaming
OCI_STREAMING_ENDPOINT=
OCI_STREAM_MAX_RETRIES=3
OCI_STREAM_RETRY_BASE_MS=200
